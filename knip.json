{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/taskpane/index.tsx"],
  "project": ["src/**/*.{ts,tsx}"],
  "webpack": true,
  "jest": true,
  "playwright": true,
  "rules": {
    "files": "error",
    "exports": "error",
    "types": "error",
    "dependencies": "off",
    "devDependencies": "off",
    "unlisted": "off",
    "binaries": "off",
    "unresolved": "off"
  }
}
