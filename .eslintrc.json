{
  "env": {
    "browser": true,
    "node": true,
    "es2021": true,
    "jest": true
  },
  "plugins": [
    "office-addins",
    "jsx-a11y"
  ],
  "extends": [
    "plugin:office-addins/react",
    "plugin:jsx-a11y/recommended"
  ],
  "rules": {
    "no-undef": "off",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "@typescript-eslint/no-unused-vars": "off"
  },
  "overrides": [
    {
      "files": [
        "**/*.ts",
        "**/*.tsx"
      ],
      "rules": {
        "no-undef": "off",
        "@typescript-eslint/no-unused-vars": "off"
      }
    }
  ]
}