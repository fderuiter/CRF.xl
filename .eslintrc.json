{
  "env": {
    "browser": true,
    "node": true,
    "es2021": true,
    "jest": true
  },
  "plugins": [
    "office-addins",
    "jsx-a11y"
  ],
  "extends": [
    "plugin:office-addins/react",
    "plugin:jsx-a11y/recommended"
  ],
  "rules": {
    "no-undef": "off"
  },
  "overrides": [
    {
      "files": [
        "**/*.ts",
        "**/*.tsx"
      ],
      "rules": {
        "no-undef": "off"
      }
    }
  ]
}
