{
  "name": "office-addin-taskpane-react",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/OfficeDev/Office-Addin-TaskPane-React.git"
  },
  "license": "MIT",
  "config": {
    "app_to_debug": "excel",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "signin": "office-addin-dev-settings m365-account login",
    "signout": "office-addin-dev-settings m365-account logout",
    "start": "office-addin-debugging start manifest.dev.xml",
    "stop": "office-addin-debugging stop manifest.dev.xml",
    "validate": "office-addin-manifest validate manifest.dev.xml",
    "manifest:dev": "office-addin-manifest validate manifest.dev.xml",
    "manifest:staging": "office-addin-manifest validate manifest.staging.xml",
    "manifest:production": "office-addin-manifest validate manifest.production.xml",
    "manifest:uat": "office-addin-manifest validate manifest.uat.xml",
    "manifest:validate:office": "npm run manifest:dev && npm run manifest:staging && npm run manifest:production && npm run manifest:uat",
    "manifest:validate": "node ./scripts/validate-manifests.js",
    "docs:validate": "node ./scripts/validate-docs.js",
    "docs:traceability": "node ./scripts/traceability-engine.js",
    "watch": "webpack --mode development --watch",
    "test": "jest",
    "benchmark:mega-study": "jest test/serialization/mega-study.benchmark.test.ts --runInBand",
    "audit": "npm audit",
    "audit:json": "npm audit --json",
    "dead-code": "node scripts/dead-code.js"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.11.0",
    "@fluentui/react-components": "^9.55.1",
    "@fluentui/react-icons": "^2.0.264",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@types/pdfmake": "^0.3.3",
    "core-js": "^3.36.0",
    "crypto-js": "^4.2.0",
    "docx": "^9.6.1",
    "es6-promise": "^4.2.8",
    "exceljs": "^4.4.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^1.16.0",
    "pdfmake": "^0.3.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-typescript": "^7.23.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/html2pdf.js": "^0.10.0",
    "@types/jest": "^30.0.0",
    "@types/office-js": "^1.0.591",
    "@types/office-runtime": "^1.0.35",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/webpack": "^5.28.5",
    "acorn": "^8.11.3",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-office-addins": "^4.0.3",
    "eslint-plugin-react": "^7.28.0",
    "file-loader": "^6.2.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "less": "^4.2.0",
    "less-loader": "^12.2.0",
    "office-addin-cli": "^2.0.3",
    "office-addin-debugging": "^6.0.7",
    "office-addin-dev-certs": "^2.0.3",
    "office-addin-lint": "^3.0.3",
    "office-addin-manifest": "^2.0.3",
    "office-addin-prettier-config": "^2.0.1",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "source-map-loader": "^5.0.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.1",
    "ts-prune": "^0.10.3",
    "typescript": "^5.4.2",
    "webpack": "^5.95.0",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.5"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "last 2 versions",
    "ie 11"
  ]
}
