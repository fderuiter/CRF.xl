{
  "name": "office-addin-taskpane-react",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/OfficeDev/Office-Addin-TaskPane-React.git"
  },
  "license": "MIT",
  "config": {
    "app_to_debug": "excel",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "setup": "npm install && npm run validate",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "signin": "office-addin-dev-settings m365-account login",
    "signout": "office-addin-dev-settings m365-account logout",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "node ./scripts/validate-manifests.js",
    "docs:validate": "node ./scripts/validate-docs.js",
    "docs:traceability": "node ./scripts/traceability-engine.js",
    "watch": "webpack --mode development --watch",
    "test": "jest",
    "test:e2e": "playwright test",
    "benchmark:mega-study": "jest test/serialization/mega-study.benchmark.test.ts --runInBand",
    "audit": "npm audit",
    "audit:json": "npm audit --json",
    "dead-code": "node scripts/dead-code.js"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@azure/msal-browser": "^5.11.0",
    "@fluentui/react-components": "^9.55.1",
    "@fluentui/react-icons": "^2.0.264",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@playwright/test": "^1.61.1",
    "core-js": "^3.36.0",
    "crypto-js": "^4.2.0",
    "docx": "^9.6.1",
    "es6-promise": "^4.2.8",
    "exceljs": "^4.4.0",
    "html-to-docx": "^1.8.0",
    "html-to-pdfmake": "^2.5.33",
    "pdfmake": "^0.3.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "regenerator-runtime": "^0.14.1",
    "scheduler": "^0.27.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-typescript": "^7.23.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/crypto-js": "^4.2.2",
    "@types/html-to-docx": "^1.8.1",
    "@types/html-to-pdfmake": "^2.4.5",
    "@types/jest": "^30.0.0",
    "@types/office-js": "^1.0.591",
    "@types/office-runtime": "^1.0.35",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/webpack": "^5.28.5",
    "assert": "^2.1.0",
    "babel-loader": "^9.1.3",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "copy-webpack-plugin": "^14.0.0",
    "crypto-browserify": "^3.12.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-office-addins": "^4.0.10",
    "eslint-plugin-react": "^7.28.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "https-browserify": "^1.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "less-loader": "^12.2.0",
    "office-addin-cli": "^2.0.3",
    "office-addin-debugging": "^6.0.7",
    "office-addin-dev-certs": "^2.0.3",
    "office-addin-lint": "^3.0.3",
    "office-addin-manifest": "^2.0.3",
    "office-addin-prettier-config": "^2.0.1",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "source-map-loader": "^5.0.0",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.1",
    "ts-prune": "^0.10.3",
    "typescript": "^5.4.2",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "webpack": "^5.95.0",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^6.0.0"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "last 2 versions"
  ]
}
